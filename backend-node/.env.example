# === Servidor ===
PORT=4000
NODE_ENV=development

# === Base de datos (MySQL vía Sequelize/mysql2) ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finca_la_primavera
DB_USER=root
DB_PASSWORD=changeme
DB_LOGGING=false

# === Autenticacion JWT ===
# Genere secretos distintos y largos:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Seguridad ===
# Costo de bcrypt para cifrar contrasenas (12 recomendado).
BCRYPT_ROUNDS=12
# Secreto de los tokens CSRF (opcional; si se omite se deriva de JWT_ACCESS_SECRET).
# CSRF_SECRET=
# Fuerza bruta en login: intentos fallidos permitidos por IP+usuario en la ventana.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
API_MAX_REQUESTS_PER_MINUTE=300

# === Contrasenas iniciales del seed (opcional; si se omiten se generan al azar y se muestran) ===
# SEED_ADMIN_PASSWORD=
