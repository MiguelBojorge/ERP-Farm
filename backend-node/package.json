{
  "name": "finca-la-primavera-backend",
  "version": "1.0.0",
  "description": "ERP para gestion de ganaderia (vacas y cerdos) - API REST en Node.js/Express (migrado desde Django REST Framework)",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
